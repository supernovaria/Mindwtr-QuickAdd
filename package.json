{
  "name": "mindwtr-quickadd",
  "productName": "Mindwtr QuickAdd",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Quick-capture window for Mindwtr, via Mindwtr's Local API",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "build": "node scripts/build.mjs",
    "dist": "node scripts/build.mjs && node scripts/make-icon.mjs && electron-builder --win nsis --publish never",
    "start": "electron .",
    "mock-api": "node scripts/mock-local-api.mjs --port 3457 --token dev-token",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.4",
    "@noble/hashes": "^2.3.0",
    "chrono-node": "^2.9.0",
    "date-fns": "^4.1.0",
    "date-fns-jalali": "4.4.0-0",
    "fflate": "^0.8.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "uqr": "0.1.3",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "~19.1.0",
    "@types/react-dom": "~19.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "typescript": "~5.9.2",
    "vite": "^8.3.5",
    "vitest": "4.1.12"
  },
  "main": "out/main/index.cjs",
  "author": "Mindwtr QuickAdd contributors",
  "build": {
    "appId": "com.mindwtr.quickadd",
    "productName": "Mindwtr QuickAdd",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json",
      "!node_modules/**"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  }
}
